max-history=5
sort=-time
on-button-left=dismiss
on-button-right=invoke-default-action
default-timeout=5000
max-visible=5

# Look (matches waybar pills / hyprland rounding)
font=JetBrainsMono Nerd Font 11
width=360
padding=12
margin=10
border-size=2
border-radius=10
icons=1
max-icon-size=48
outer-margin=8

# Colors

background-color=#1e1e2ee6
text-color=#cdd6f4
border-color=#b4befe
progress-color=over #313244

[urgency=high]
border-color=#fab387
